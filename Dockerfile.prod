# Production image for the Mineral Explorer backend (see DEPLOYMENT.md)

# ---- Build stage: compile native modules (bcrypt) ----
FROM node:22-bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev && npm cache clean --force

# ---- Runtime stage: no compilers, non-root user ----
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    SERVER_HOST=0.0.0.0 \
    PORT=4006

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --chown=node:node . .

RUN chmod +x docker-entrypoint.sh

# Uploaded images are written here; mounted as a volume in production
RUN mkdir -p public/resource && chown -R node:node public/resource

USER node

EXPOSE 4006

# Runs migrations, then starts the server
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["node", "index.js"]
