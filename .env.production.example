# Production settings for docker-compose.prod.yml - see DEPLOYMENT.md
# Copy to .env.production on the server and replace every value.
# .env.production is gitignored: never commit it.

# PostgreSQL (the database container is created with these values)
DB_USER=mom_expo
DB_PASSWORD=change-me-to-a-long-random-password
DB_NAME=mom_expo

# Signs login session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
