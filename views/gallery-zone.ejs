<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mineral Explorer</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.13.0/css/all.min.css"> -->
    <link rel="icon" href="images/logo.png" type="image/x-icon">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.0/css/font-awesome.all.min.css">
    <script src="https://kit.fontawesome.com/e807667acd.js" crossorigin="anonymous"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Russo+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Bhai+2&family=KoHo:wght@500&family=Montserrat:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600&family=Titillium+Web:wght@300&display=swap" rel="stylesheet">
    <link href='stylesheets/style.css' rel='stylesheet' />
    <link rel="stylesheet" href="static/bootstrap/css/bootstrap.css">
    <link rel="stylesheet" href="stylesheets/loader.css">

</head>

<body>
    <header>
        <!-- <nav id="navbar">
            <div class="dropdown show">
                <a class="dropdown-toggle text-gold" href="#" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <img src="images/logo.png" alt="" class="logo-img">
                </a>
    
                <div class="dropdown-menu text-gold" aria-labelledby="dropdownMenuLink">
                    <a href="#" class="dropdown-item">Login</a>
                </div>
                    <img class="logo" src="images/logo.png" alt="logo"> -->
            <!-- </div>
          </nav> --> 
          <nav id="navbar" class="no-select" unselectable="on" >
            <img src="images/logo.png" alt="" class="logo-img">
            
            <!-- <img class="logo" src="images/logo.png" alt="logo"> -->
            
          </nav>
    </header>
    <div class="preloader-wrapper">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <main>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-gold" href="/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= zone.Name %></li>
            </ol>
          </nav>
        <section class="upper-controller no-select" unselectable="on" >
            <div class="map">
                <img src="<%= zone_img_path %> " alt="" class="map-img">
            </div>
            
            <div class="region-info">
                <h2 class="region-title"><b><%= zone.Name %></b></h2>
                <div class="region-area">
                    <h6 class="region-area-label"> <b>Area:</b> </h6>
                    <h6 class="region-area-value"> <%= zone.Area %> km<sup>2</sup></h6>
                </div>
                <div class="region-status">
                    <h6 class="region-status-label"> <b>Common Resource Types:</b> </h6>
                    <% if (common_res_types) { %>
                        <% for (let common_res of common_res_types) { %>
                            <% if (common_res.type === 'Metallic Mineral') { %>
                                <h6 class="res-tag metallic-res"> <%= common_res.type %>  </h6>
                            <% } else if (common_res.type === 'Fertilizer Raw Material') { %> 
                                <h6 class="res-tag fertilizer-res"><%= common_res.type %></h6>
                            <% } else if (common_res.type === 'Energy Mineral') { %> 
                                <h6 class="res-tag energy-res"><%= common_res.type %></h6>
                            <% } else if (common_res.type === 'Industrial Mineral') { %> 
                                <h6 class="res-tag industrial-res"><%= common_res.type %></h6>
                            <% } else if (common_res.type === 'Construction Material') { %> 
                                <h6 class="res-tag construction-res"><%= common_res.type %></h6>
                            <% } else if (common_res.type === 'Gemstone') { %> 
                                <h6 class="res-tag gemstone-res"><%= common_res.type %></h6>
                            <% } else { %> 
                                <h6 class="res-tag industrial-res"><%= common_res.type %></h6>
                            <% } %> 
                        <% } %> 
                    <% } %> 
                </div>
                <p class="region-bio"> <%= zone.Description %> </p>
            </div>
        </section>

        <section class="lower no-select" unselectable="on">
            <div class="main-scroll-div">
                <button class="arrow-btn" onclick="scroll_left()">
                    <i class="fa-solid fa-arrow-left-long"></i>
                </button>

                <div class="cover">
                    <div class="scroll-img">
                        <% if (resources.length > 0) { %> 
                            <% for (let resource of resources) { %> 
                                <div class="child">
                                    <a href="" class="child-img-link" data-bs-toggle="modal" data-bs-target="#res-<%= resource.id %>">
                                        <img src="<%= resource.img_path %> " alt="" class="child-img">
                                    </a>
                                    <h5 class="child-img-name"><%= resource.name %> </h5>
                                </div>
                            <% } %> 
                        <% } %> 
                    </div>

                </div>
                
                <button class="arrow-btn" onclick="scroll_right()">
                    <i class="fa-solid fa-arrow-right-long"></i>
                </button>
            </div>

            <script>
                const scroll_left = () => {
                    const deck = document.querySelector(".scroll-img");
                    deck.scrollBy(-350,0);
                }

                const scroll_right = () => {
                    const deck = document.querySelector(".scroll-img");
                    deck.scrollBy(350,0);
                }
            </script>
            <% if (resources.length > 0) { %> 
            <% for (let resource of resources) { %> 
            <!-- Resource Modal -->
            <div class="modal fade no-select" unselectable="on" id="res-<%= resource.id %>" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" >
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="modal-body-container">
                                <div class="item-pic">
                                    <img class="modal-img" src="<%= resource.img_path %> " alt="">
                                </div>

                                <div class="item-description">
                                    
                                    <div class="item-description general">
                                        
                                        <div class="item-title">
                                            <h2 class="item-name"><%= resource.name %></h2>
                                        </div>

                                        <div class="item-tag">
                                            <% if (resource.type === 'Metallic Mineral') { %>
                                                <h6 class="res-tag metallic-res"> <%= resource.type %>  </h6>
                                            <% } else if (resource.type === 'Fertilizer Raw Material') { %> 
                                                <h6 class="res-tag fertilizer-res"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Energy Mineral') { %> 
                                                <h6 class="res-tag energy-res"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Industrial Mineral') { %> 
                                                <h6 class="res-tag industrial-res"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Construction Material') { %> 
                                                <h6 class="res-tag construction-res"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Gemstone') { %> 
                                                <h6 class="res-tag gemstone-res"><%= resource.type %></h6>
                                            <% } else { %> 
                                                <h6 class="res-tag industrial-res"><%= resource.type %></h6>
                                            <% } %> 
                                        </div>
                                    </div>

                                    <div class="more-details-cover">
                                        <div id="accordion" class="more-details-gallery">
                                            <div class="item-bio">
                                                <p class="item-bio-text"> <%= resource.description %> </p>
                                            </div>
    
                                            <div class="accordion accordion-flush" id="itemAccordion">
                                                <div class="accordion-item">
                                                  <h2 class="accordion-header" id="headingOne">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                                      Properties
                                                    </button>
                                                  </h2>
                                                  <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#itemAccordion">
                                                    <div class="accordion-body">
                                                        <div class="item-description-body">
                                                            <% for (let property of resource.properties) { %> 
                                                            <p class="item-properties-text"><b class="bold-title" ><%= property.title %> </b> <%= property.description %> </p>
                                                            <% } %> 
                                                        </div>
                                                    </div>
                                                  </div>
                                                </div>
                                                <div class="accordion-item">
                                                  <h2 class="accordion-header" id="headingTwo">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                                      Origin and Occurence
                                                    </button>
                                                  </h2>
                                                  <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#itemAccordion">
                                                    <div class="accordion-body">
                                                        <div class="item-description-body">
                                                            <p class="item-description-text"> <%= resource.origin_occ %> </p>
                                                        </div>
                                                    </div>
                                                  </div>
                                                </div>
                                                <div class="accordion-item">
                                                  <h2 class="accordion-header" id="headingThree">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                                      Applications
                                                    </button>
                                                  </h2>
                                                  <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#itemAccordion">
                                                    <div class="accordion-body">
                                                        <div class="item-description-body">
                                                            <% for (let application of resource.applications) { %> 
                                                            <p class="item-description-text"><b class="bold-title" ><%= application.title %> </b> <%= application.description %> </p>
                                                            <% } %> 
                                                        </div>
                                                    </div>
                                                  </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                
                                    
                                </div>
                                
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
            <% } %> 
            <% } %> 
        </section>

        
    </main>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
    <script src="scripts/loader.js"></script>

    
</body>
</html>