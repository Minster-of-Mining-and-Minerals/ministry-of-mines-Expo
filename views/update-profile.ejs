<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Update Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link rel="stylesheet" href="stylesheets/base.css">
    <link rel="stylesheet" href="stylesheets/index.css">
    <link rel="stylesheet" href="stylesheets/login.css">
    <link rel="icon" href="images/logo.png" type="image/x-icon">
    <style>
        .user-table-row {
            cursor: pointer;
            transition: background 0.2s;
        }

        .user-table-row:hover {
            background: rgba(255, 200, 0, 0.08) !important;
        }

        .badge-admin {
            background: #ffc107;
            color: #000;
        }

        .badge-staff {
            background: #0dcaf0;
            color: #000;
        }

        .badge-user {
            background: #6c757d;
            color: #fff;
        }

        .modal-content {
            background: #0d1420;
            border: 1px solid #ffc10740;
            color: #fff;
        }

        .modal-header {
            border-bottom: 1px solid #ffc10730;
        }

        .modal-footer {
            border-top: 1px solid #ffc10730;
        }

        .section-title {
            color: #ffc107;
            letter-spacing: 1px;
            font-size: 0.85rem;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .users-table th {
            color: #ffc107;
            border-color: #ffc10730;
            font-size: 0.8rem;
            text-transform: uppercase;
        }

        .users-table td {
            border-color: #ffc10715;
            vertical-align: middle;
            font-size: 0.9rem;
        }

        .users-table {
            background: transparent;
        }
    </style>
</head>

<body>
    <header>
        <nav id="navbar" class="d-flex justify-content-between align-items-center" style="padding-right: 20px;">
            <img src="images/logo.png" alt="" class="logo-img" onclick="window.location.href='/'"
                style="cursor: pointer;">
            <a href="/" class="btn btn-outline-light">Back to Home</a>
        </nav>
    </header>

    <section class="prompt">
        <h3>Update Profile</h3>
        <hr>
        <% if (message) { %>
            <div class="alert alert-success" role="alert">
                <%= message %>
            </div>
            <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                    <% } %>
                        <form class="content-upload-form" action="/profile" method="POST">
                            <div class="form-row">
                                <div class="form-group col-md-12 text-gold">
                                    <label for="username">Username</label>
                                    <input type="text" id="username" name="username" class="text-light bg-dark"
                                        value="<%= user.username %>" required>
                                </div>
                            </div>

                            <div class="form-row mt-3">
                                <div class="form-group col-md-12 text-gold">
                                    <label for="password">New Password (leave blank to keep current)</label>
                                    <input type="password" id="password" name="password" class="text-light bg-dark">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-12 text-gold">
                                    <label for="c_confirm">Confirm New Password</label>
                                    <input type="password" id="c_confirm" name="c_password" class="text-light bg-dark">
                                </div>
                            </div>

                            <div class="upload-btn-container mt-2">
                                <button type="submit" class="btn btn-warning btn-lg upload-btn">Update Profile</button>
                            </div>
                        </form>

                        <%# ---- Admin: User List ---- %>
                            <% if (allUsers && allUsers.length> 0) { %>
                                <div class="mt-5">
                                    <p class="section-title">Manage User Passwords</p>
                                    <table class="table users-table">
                                        <thead>
                                            <tr>
                                                <th>Username</th>
                                                <th>Role</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% allUsers.forEach(function(u) { %>
                                                <tr class="user-table-row">
                                                    <td class="text-light">
                                                        <%= u.username %>
                                                    </td>
                                                    <td>
                                                        <% if (u.is_admin) { %>
                                                            <span class="badge badge-admin">Admin</span>
                                                            <% } else if (u.is_staff) { %>
                                                                <span class="badge badge-staff">Staff</span>
                                                                <% } else { %>
                                                                    <span class="badge badge-user">User</span>
                                                                    <% } %>
                                                    </td>
                                                    <td class="d-flex gap-2">
                                                        <button class="btn btn-sm btn-outline-warning"
                                                            data-bs-toggle="modal" data-bs-target="#passwordModal"
                                                            data-userid="<%= u.id %>" data-username="<%= u.username %>"
                                                            onclick="openPasswordModal(this)">
                                                            Reset Password
                                                        </button>
                                                        <% if (!u.is_admin) { %>
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                                data-userid="<%= u.id %>"
                                                                data-username="<%= u.username %>"
                                                                onclick="openDeleteModal(this)">
                                                                Delete
                                                            </button>
                                                            <% } %>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                                <% } %>
    </section>

    <%# ---- Password Reset Modal ---- %>
        <div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-warning" id="passwordModalLabel">Reset Password</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    <form action="/profile" method="POST">
                        <input type="hidden" name="userId" id="modalUserId">
                        <div class="modal-body">
                            <p class="text-muted mb-3">Resetting password for: <strong class="text-warning"
                                    id="modalUsername"></strong></p>
                            <div class="mb-3">
                                <label for="modalPassword" class="form-label text-light">New Password</label>
                                <input type="password" class="form-control bg-dark text-light border-secondary"
                                    id="modalPassword" name="password" required>
                            </div>
                            <div class="mb-3">
                                <label for="modalConfirm" class="form-label text-light">Confirm Password</label>
                                <input type="password" class="form-control bg-dark text-light border-secondary"
                                    id="modalConfirm" name="c_password" required>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning">Update Password</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%# ---- Delete Confirmation Modal ---- %>
            <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title text-danger" id="deleteModalLabel">Delete User</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                        </div>
                        <form action="/profile/delete-user" method="POST">
                            <input type="hidden" name="userId" id="deleteUserId">
                            <div class="modal-body">
                                <p class="text-light">Are you sure you want to delete <strong class="text-danger"
                                        id="deleteUsername"></strong>?</p>
                                <p class="text-muted small">This action is <strong>irreversible</strong>. All associated
                                    records will be permanently removed.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-light"
                                    data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Yes, Delete User</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <footer class="info">
                <p>Authentication powered by <a href="https://www.passportjs.org">Passport</a></p>
            </footer>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
                crossorigin="anonymous"></script>
            <script>
                function openPasswordModal(btn) {
                    document.getElementById('modalUserId').value = btn.dataset.userid;
                    document.getElementById('modalUsername').textContent = btn.dataset.username;
                    document.getElementById('modalPassword').value = '';
                    document.getElementById('modalConfirm').value = '';
                }
                function openDeleteModal(btn) {
                    document.getElementById('deleteUserId').value = btn.dataset.userid;
                    document.getElementById('deleteUsername').textContent = btn.dataset.username;
                }
            </script>
</body>

</html>