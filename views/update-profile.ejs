<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Update Profile</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
		<link rel="stylesheet" href="stylesheets/base.css">
		<link rel="stylesheet" href="stylesheets/index.css">
		<link rel="stylesheet" href="stylesheets/login.css">
        <link rel="icon" href="images/logo.png" type="image/x-icon">
	</head>
	<body>
        <header>
            <nav id="navbar">
                <img src="images/logo.png" alt="" class="logo-img" onclick="window.location.href='/'" style="cursor: pointer;">
            </nav>
        </header>

		<section class="prompt">
			<h3>Update Profile</h3>
			<hr>
            <% if (message) { %>
                <div class="alert alert-success" role="alert">
                    <%= message %>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
            <% } %>
			<form class="content-upload-form" action="/profile" method="POST" >
                <div class="form-row">
                    <div class="form-group col-md-12 text-gold">
                      <label for="username">Username</label>
                      <input type="text" id="username" name="username" class="text-light bg-dark" value="<%= user.username %>" required>
                    </div>
                </div>

                <div class="form-row mt-3">
                    <div class="form-group col-md-12 text-gold">
                      <label for="password">New Password (leave blank to keep current)</label>
                      <input type="password" id="password" name="password" class="text-light bg-dark">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-12 text-gold">
                      <label for="c_confirm">Confirm New Password</label>
                      <input type="password" id="c_confirm" name="c_password" class="text-light bg-dark">
                    </div>
                </div>
      
                <div class="upload-btn-container mt-4">
                    <button type="submit" class="btn btn-warning btn-lg upload-btn">Update Profile</button>
                    <a href="/" class="btn btn-outline-light btn-lg upload-btn ms-2">Back to Home</a>
                </div>
            </form>
		</section>
		<footer class="info">
			<p>Authentication powered by <a href="https://www.passportjs.org">Passport</a></p>
		</footer>
	</body>
</html>
