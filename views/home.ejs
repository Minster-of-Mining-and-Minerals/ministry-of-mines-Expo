<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Exhibition</title>
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
        
        <link href='/stylesheets/style.css' rel='stylesheet' />
        <script src="https://kit.fontawesome.com/e807667acd.js" crossorigin="anonymous"></script>
        
    </head>

    <body>
        <header>
            <nav id="navbar">
                
                <img src="/images/logo.png" alt="" >
                
                <!-- <img class="logo" src="images/logo.png" alt="logo"> -->
                
            </nav>
        </header>

        <section class="upper">
            <img src="/images/ethiopia_west_geo_map.jpeg" alt="" class="map">
            <div class="region-info">
                <h3 class="region-title">Western Zone</h3>
                <p class="region-bio"> Located in western Ethiopia, the West Zone is home to low grade Volcanosedimentary rocks, high grade Gneisses and Intrusives
                    <br>
                    This zone is particulary known for its rich deposits of Coal and Iron Ore, and gemstones such as Opal, Amethyst and Ruby
                </p>
            </div>
        </section>

        <section class="lower">
            <div class="main-scroll-div">
                <button class="arrow-btn" onclick="scroll_left()">
                    <i class="fa-solid fa-arrow-left-long"></i>
                </button>
                <div class="cover">
                    <div class="scroll-img">
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img1.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img2.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img3.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img4.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img5.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img1.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img2.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img3.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img4.jpg" alt="" class="child-img">
                            </a>
                        </div>
                        <div class="child">
                            <a href="" data-toggle="modal" data-target="#itemModal">
                                <img src="/images/region1/img5.jpg" alt="" class="child-img">
                            </a>
                        </div>
                    </div>
                </div>
                
                <button class="arrow-btn" onclick="scroll_right()">
                    <i class="fa-solid fa-arrow-right-long"></i>
                </button>
            </div>

            <script>
                const scroll_left = () => {
                    const deck = document.querySelector(".scroll-img");
                    deck.scrollBy(-350,0);
                }

                const scroll_right = () => {
                    const deck = document.querySelector(".scroll-img");
                    deck.scrollBy(350,0);
                }
            </script>

            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModalCenter">
                Launch demo modal
            </button>
            
            <!-- Modal -->
            <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Modal title</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    </div>
                    <div class="modal-body">
                    </div>
                    <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Save changes</button>
                    </div>
                </div>
                </div>
            </div>
            <!-- Invite team member modal -->
            <div class="modal fade" id="itemModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="container-fluid modal-body-container">
                                <div class="modal-body-content item-pic">
                                    <img class="modal-img" src="/images/region1/img1.jpg" alt="">
                                </div>

                                <div class="modal-body-content item-description">
                                    <p class="item-description"> Lorem ipsum dolor sit amet consectetur adipisicing elit. Adipisci illum architecto culpa cum sunt, ipsam odio rerum consequuntur eveniet blanditiis voluptatem ullam placeat eos maiores dignissimos laboriosam fugit vel dolorum! Lorem, ipsum dolor sit amet consectetur adipisicing elit. Dignissimos, unde! Ea ducimus est rerum error fugit nobis quaerat necessitatibus eligendi quo? Rerum nostrum minus explicabo dolorum, iusto commodi placeat possimus.</p>
                                </div>
                                
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </section>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.10.2/dist/umd/popper.min.js" integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
    </body>

</html>
