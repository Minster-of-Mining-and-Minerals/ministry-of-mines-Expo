<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Resource</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.13.0/css/all.min.css"> -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.0/css/font-awesome.all.min.css">
    <script src="https://kit.fontawesome.com/e807667acd.js" crossorigin="anonymous"></script>
    <link href='../stylesheets/style.css' rel='stylesheet' />
</head>

<body>
    <header>
        <nav id="navbar">
            <a href="/">
                <img src="/images/logo.png" alt="" class="child-img">
            </a>
            <!-- <img class="logo" src="images/logo.png" alt="logo"> -->
            
          </nav>
    </header>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a class="text-gold" href="/">Home</a></li>
            <li class="breadcrumb-item"><a class="text-gold" href="<%= return_to %>"><%= zone.Name %> </a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Resource</li>
        </ol>
    </nav>

    <main class="upload-page">

        <div class="content-upload-title">
            <h3 class="content-upload-title text-gold">Edit Resource</h3>
        </div>

        <form class="content-upload-form" action="/edit/<%= resource.id %> " method="POST" enctype="multipart/form-data">
            <div class="form-group col-md-4 text-gold resource-zone"">
                <label for="inputState">Zone</label>
                <select id="inputState" name="zone" class="form-control text-light bg-dark">
                  <option selected><%= zone.Name %> </option>
                  <option>Northern Zone</option>
                  <option>North-Eastern Zone</option>
                  <option>Eastern Zone</option>
                  <option>Western Zone</option>
                  <option>Southern Zone</option>
                </select>
            </div>
            <div class="form-row resource-bio">
              <div class="form-group col-md-6 text-gold">
                <label for="inputEmail4">Resource Name</label>
                <input type="text" name="res_name" class="form-control text-light bg-dark" value="<%= resource.name %> " placeholder="Name">
              </div>
              <div class="form-group col-md-4 text-gold">
                <label for="inputPassword4">Resource Type</label>
                <select id="inputState" name="res_type" class="form-control text-light bg-dark">
                    <option selected><%= resource.type %> </option>
                    <option>Metallic Mineral</option>
                    <option>Fertilizer Raw Material</option>
                    <option>Energy Mineral</option>
                    <option>Industrial Mineral</option>
                    <option>Construction Material</option>
                    <option>Gemstone</option>
                  </select>
              </div>
            </div>
            <div class="form-group resource-desc text-gold">
              <label for="inputDescription">Description</label>
              <textarea rows="5" name="res_desc" class="form-control text-light bg-dark" aria-label="With textarea" placeholder="Description of Resource"><%= resource.description %> </textarea>
            </div>
            
            <div id="properties" class="form-column properties">
                <div class="form-row add-field">
                    <div class="multi-field-label">
                        <label for="inputProperties" class="text-gold">Properties</label>
                    </div>
                    <div class="field-buttons">
                      <button type="button" id="add-property-btn" class="btn btn-outline-warning btn-sm add-field" ><i class="fa-solid fa-plus"></i> Add Property</button>
                      <!-- <button type="button" id="add-property-btn" class="btn btn-outline-danger btn-sm add-field" ><i class="fa-solid fa-minus"></i> Remove Property</button> -->
                    </div>
                    
                </div>
                
                <% if (resource.properties.length > 0) { %>
                    <% for (let property of resource.properties) { %> 
                <div class="form-column added-property">
                    <div class="form-group row-md-4 text-gold"">
                      <input type="text" name="res_prop_title" class="form-control text-light bg-dark title-input" value="<%= property.title %> " placeholder="Property Title">
                      <textarea name="res_prop_desc" class="form-control text-light bg-dark description-input" aria-label="With textarea" placeholder="Property Description"><%= property.description %> </textarea>
                    </div>
                </div>
                    <% } %>
                <% } %>  
            </div>
            
            <div class="form-group text-gold">
                <label for="inputDescription">Origin and Occurence</label>
                <textarea rows="5" name="res_origin" class="form-control text-light bg-dark" aria-label="With textarea" placeholder="Origin and Occurence of Resource" ><%= resource.origin_occ %> </textarea>
            </div>

            <div id="applications" class="form-column applications">
                <div class="form-row add-field">
                    <label for="inputProperties" class="text-gold">Applications</label>
                    <button type="button" id="add-application-btn" class="btn btn-outline-warning btn-sm add-field"><i class="fa-solid fa-plus"></i> Add Application</button>
                </div>
                
                <% if (resource.applications.length > 0) { %>
                    <% for (let application of resource.applications) { %>  
                <div class="form-column added-application">
                    <div class="form-group row-md-4 text-gold"">
                      <input type="text" name="res_app_title" class="form-control text-light bg-dark title-input" value="<%= application.title %>" placeholder="Application Title">
                    </div>
                    <div class="form-group row-md-4 text-gold"">
                      <textarea name="res_app_desc" class="form-control text-light bg-dark description-input" aria-label="With textarea" placeholder="Application Description"><%= application.description %> </textarea>
                    </div>
                </div>
                    <% } %>
                <% } %>  
            </div>

            <div class="mb-3">
                <label for="formFile" class="form-label text-gold">Image of Resource</label>
                <div class="edit-img-container">
                    <img class="edit-img" src="<%= resource.img_path %> " alt="">
                </div>
                <input class="form-control text-light bg-dark" name="res_image" type="file" id="formFile">
              </div>
                               
            <div class="upload-btn-container">
                <button type="submit" class="btn btn-warning btn-lg upload-btn">Edit</button>
            </div>
            
        </form>
        
          
    </main>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
    <script src="../scripts/upload.js"></script>
</body>
</html>