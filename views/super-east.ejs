<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mineral Explorer</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.13.0/css/all.min.css"> -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.0/css/font-awesome.all.min.css">
    <script src="https://kit.fontawesome.com/e807667acd.js" crossorigin="anonymous"></script>
    <link href='stylesheets/style.css' rel='stylesheet' />
    <link rel="stylesheet" href="static/bootstrap/css/bootstrap.css">
</head>

<body>
    <header>
        <nav id="navbar">
            <a href="/" data-toggle="" data-target="#exampleModal">
                <img src="images/logo.png" alt="" class="child-img">
            </a>
            <!-- <img class="logo" src="images/logo.png" alt="logo"> -->
            
          </nav>
    </header>

    <main>
        <section class="upper">
            <img src="images/geo_maps/east.jpg" alt="" class="map">
            <div class="region-info">
                <h2 class="region-title"><b><%= zone.Name %></b> <i>(Super)</i></h2>
                <div class="region-area">
                    <h6 class="region-area-label"> <b>Area:</b> </h6>
                    <h6 class="region-area-value"> <%= zone.Area %> </h6>
                </div>
                <div class="region-status">
                    <h6 class="region-status-label"> <b>Status:</b> </h6>
                    <h6 class="region-status-value"> <i><%= zone.Status %></i> </h6>
                </div>
                <p class="region-bio"> <%= zone.Description %> </p>
            </div>
        </section>

        <section class="lower">
            <div class="main-scroll-div">
                <button class="arrow-btn" onclick="scroll_left()">
                    <i class="fa-solid fa-arrow-left-long"></i>
                </button>

                <div class="cover">
                    <div class="scroll-img">
                        <% if (resources.length > 0) { %> 
                            <% for (let resource of resources) { %> 
                                <div class="child">
                                    <a href="" class="child-img-link" data-bs-toggle="modal" data-bs-target="#res-<%= resource.id %>">
                                        <img src="<%= resource.img_path %> " alt="" class="child-img">
                                    </a>
                                    <h5 class="child-img-name"><%= resource.name %> </h5>
                                </div>
                            <% } %> 
                        <% } %> 
                    </div>

                </div>
                
                <button class="arrow-btn" onclick="scroll_right()">
                    <i class="fa-solid fa-arrow-right-long"></i>
                </button>
            </div>

            <script>
                const scroll_left = () => {
                    const deck = document.querySelector(".scroll-img");
                    deck.scrollBy(-350,0);
                }

                const scroll_right = () => {
                    const deck = document.querySelector(".scroll-img");
                    deck.scrollBy(350,0);
                }
            </script>
            <% if (resources.length > 0) { %> 
            <% for (let resource of resources) { %> 
            <!-- Resource Modal -->
            <div class="modal fade" id="res-<%= resource.id %>" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" >
                <div class="modal-dialog modal-dialog-centered modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="container-fluid modal-body-container">
                                <div class="modal-body-content item-pic">
                                    <img class="modal-img" src="<%= resource.img_path %> " alt="">
                                </div>

                                <div class="modal-body-content item-description">
                                    
                                    <div class="modal-body-content item-description general">
                                        
                                        <div class="item-title">
                                            <h2 class="item-name"><b><%= resource.name %> </b></h2>
                                        </div>

                                        <div class="modal-body-content item-tag">
                                            <% if (resource.type === 'Metallic Mineral') { %>
                                                <h6 class="metallic-res-tag"> <%= resource.type %>  </h6>
                                            <% } else if (resource.type === 'Fertilizer Raw Material') { %> 
                                                <h6 class="fertilizer-res-tag"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Energy Mineral') { %> 
                                                <h6 class="energy-res-tag"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Industrial Mineral') { %> 
                                                <h6 class="industrial-res-tag"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Construction Material') { %> 
                                                <h6 class="construction-res-tag"><%= resource.type %></h6>
                                            <% } else if (resource.type === 'Gemstone') { %> 
                                                <h6 class="gemstone-res-tag"><%= resource.type %></h6>
                                            <% } else { %> 
                                                <h6 class="gemstone-res-tag"><%= resource.type %></h6>
                                            <% } %> 
                                        </div>

                                        <div class="item-description-body">
                                            <p class="item-description-text"> <%= resource.description %> </p>
                                        </div>
                                    </div>

                                    <div class="modal-body-content item-description item-properties">
                                        <div class="item-description-title">
                                            <!-- <i class="fas fas-map-location-dot"></i> -->
                                            <h4 class="item-description">Properties</h4>
                                        </div>

                                        <div class="item-description-body">
                                            <% for (let property of resource.properties) { %> 
                                            <p class="item-properties-text"><b style="font-weight: 900; font-size: 18px;" ><%= property.title %> </b> <%= property.description %> </p>
                                            <% } %> 
                                        </div>
                                    </div>

                                    <div class="modal-body-content item-description item-origin">
                                        <div class="item-description-title">
                                            <h4 class="item-description">Origin and Occurence</h4>
                                        </div>

                                        <div class="item-description-body">
                                            <p class="item-origin-text"> <%= resource.origin_occ %> </p>
                                        </div>
                                        
                                    </div>

                                    <div class="modal-body-content item-description item-applications">
                                        <div class="item-description-title">
                                            <!-- <i class="fa-solid fa-hammer"></i> -->
                                            <h4 class="item-description">Application</h4>
                                        </div>

                                        <div class="item-description-body">
                                            <% for (let application of resource.applications) { %> 
                                            <p class="item-applications-text"><b style="font-weight: 900; font-size: 18px;" ><%= application.title %> </b> <%= application.description %> </p>
                                            <% } %> 
                                        </div>
                                    </div>
                                    
                                </div>
                                
                                <div class="modal-footer">
                                    <form action="/delete/<%= resource.id %>?_method=DELETE" method="POST">
                                        <button type="submit" class="btn btn-danger btn-lg upload-btn">Delete Resource</button>
                                    </form>

                                    <form action="/edit/<%= resource.id %>">
                                        <button type="submit" class="btn btn-warning btn-lg upload-btn">Edit Resource</button>
                                    </form>
                                    
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
            <% } %> 
            <% } %> 
        </section>

        <section class="upload">
            <button type="button" class="btn btn-warning" onclick="window.location.href = '/upload';" >Upload Resource</button>
        </section>
        
    </main>
    
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
</body>

</html>