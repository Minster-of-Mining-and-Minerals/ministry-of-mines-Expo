<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mineral Explorer</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.13.0/css/all.min.css"> -->
    <link rel="icon" href="/images/logo.png" type="image/x-icon">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.0/css/font-awesome.all.min.css">
    <script src="https://kit.fontawesome.com/e807667acd.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600&family=Titillium+Web:wght@300&display=swap" rel="stylesheet">
    <link href='../stylesheets/style.css' rel='stylesheet' />
    <link href='../stylesheets/loader.css' rel='stylesheet' />
</head>

<body>

    <header>
        <nav id="navbar">
            <a href="/">
                <img src="/images/logo.png" alt="" class="logo-img">
            </a>            
        </nav>
    </header>

    <div class="preloader-wrapper">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a class="text-gold" href="/">Home</a></li>
            <li class="breadcrumb-item"><a class="text-gold" href="<%= return_to %> "><%= zone_name %> </a></li>
            <li class="breadcrumb-item active" aria-current="page">Add Gallery User</li>
        </ol>
    </nav>

    <main class="upload-page">
        
        <div class="content-upload-title">
            <h3 class="content-upload-title text-gold">Add Gallery User</h3>
        </div>

        <form class="content-upload-form-gallery" action="/register/gallery-user" method="POST">
            <div class="form-row">
                <div class="form-group col-md-5 text-gold">
                    <label for="inputEmail4">Username</label>
                    <input type="text" name="username" class="form-control text-light bg-dark" placeholder="Username" required>
                </div>

                <div class="form-group col-md-5 text-gold">
                    <label for="inputEmail4">Role</label>
                    <select id="inputState" name="role" class="form-control text-light bg-dark" required>
                        <option selected>Choose...</option>
                        <option value="North">Northern Zone Viewer</option>
                        <option value="North-East">North-Eastern Zone Viewer</option>
                        <option value="East">Eastern Zone Viewer</option>
                        <option value="West">Western Zone Viewer</option>
                        <option value="South">Southern Zone Viewer</option>
                        <option>Instructor</option>
                      </select>
                </div>
            </div>
            
            <div class="form-row mg-2">
              <div class="form-group col-md-5 text-gold space-evenly">
                <label for="inputEmail4">Password</label>
                <input type="password" name="password" class="form-control text-light bg-dark"  placeholder="Password" required>
              </div>
              <div class="form-group col-md-5 text-gold">
                <label for="inputPassword4">Confirm Password</label>
                <input type="password" name="c_password" class="form-control text-light bg-dark title-input"  placeholder="Confirm Password" required>
              </div>
            </div>
            
                               
            <div class="upload-btn-container">
                <button type="submit" class="btn btn-warning btn-lg upload-btn"><i class="fa-solid fa-user-plus"></i> Add User</button>
            </div>
            
        </form>
          
    </main>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
    <script src="../scripts/upload.js"></script>
    <script src="../scripts/loader.js"></script>
</body>
</html>