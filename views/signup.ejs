<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Register</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
		<link rel="stylesheet" href="stylesheets/base.css">
		<link rel="stylesheet" href="stylesheets/index.css">
		<link rel="stylesheet" href="stylesheets/login.css">
	</head>
	<body>
        <header>
            <nav id="navbar">
                <img src="images/logo.png" alt="" class="logo-img">
            </nav>
        </header>

		<section class="prompt">
			<h3>Register</h3>
			<hr>
			<form class="content-upload-form" action="/signup" method="POST" >
                <div class="form-row ">
                  <div class="form-group col-md-5 text-gold">
                    <label for="staff-f_name">First Name</label>
                    <input type="text" id="staff-f_name" name="first_name" class="text-light bg-dark">
                  </div>
                  <div class="form-group col-md-5 text-gold">
                    <label for="staff-l_name">Last Name</label>
                    <input type="text" id="staff-l_name" name="last_name" class="text-light bg-dark">
                  </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6 text-gold">
                      <label for="staff-email">Email</label>
                      <input type="email" id="staff-email" name="email" class="text-light bg-dark">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-5 text-gold">
                      <label for="staff-username">Username</label>
                      <input type="text" id="staff-username" name="username" class="text-light bg-dark">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-5 text-gold">
                      <label for="staff-pass">Password</label>
                      <input type="password" id="staff-pass" name="password" class="text-light bg-dark">
                    </div>
                    <div class="form-group col-md-5 text-gold">
                      <label for="staff-c_pass">Confirm Password</label>
                      <input type="password" id="staff-c_pass" name="c_password" class="text-light bg-dark">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group col-md-6 text-gold resource-zone"">
                        <label for="staff-org">Organization</label>
                        <select id="staff-org" name="organization" class="form-control text-light bg-dark" required>
                          <option selected>Choose...</option>
                          <option>Ministry of Mines and Petroleum</option>
                          <option>Geological Surveys of Ethiopia</option>
                          <option>Other</option>
                        </select>
                    </div>
    
                    <div class="form-group col-md-5 text-gold">
                        <label for="staff-role">Role</label>
                        <input type="text" id="staff-role" name="role" class="text-light bg-dark">
                    </div>
                </div>
                
                
    
                <div class="form-group text-gold">
                    <div class="form-check">
                      <input class="form-check-input bg-dark" type="checkbox" id="gridCheck">
                      <label class="form-check-label" for="gridCheck">
                        I agree to the Terms of Service
                      </label>
                    </div>
                </div>
      
                <div class="upload-btn-container">
                    <button type="submit" class="btn btn-primary btn-lg upload-btn">Register</button>
                </div>
                
            </form>
			<p class="help">Already have an account? <a href="/login">Sign in</a></p>
		</section>
		<footer class="info">
			<p>Created by <a href="https://www.jaredhanson.me">Jared Hanson</a></p>
			<p>Part of <a href="https://todomvc.com">TodoMVC</a></p>
			<p>Authentication powered by <a href="https://www.passportjs.org">Passport</a></p>
		</footer>
	</body>
</html>
